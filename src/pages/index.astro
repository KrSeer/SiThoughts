---
import Layout from '../layouts/Layout.astro';

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
---

<Layout title="SiThoughts · Hello World">
  <h1>Hello World</h1>
  <p>
    这是 SiThoughts 的第一条内容 —— 一个用 <strong>Astro</strong> 渲染、
    托管在 <strong>GitHub Pages</strong> 上的静态页面。
  </p>
  <p>
    <a href={`${base}hello/`}>去看看 Hello 页面 →</a>
  </p>
</Layout>
